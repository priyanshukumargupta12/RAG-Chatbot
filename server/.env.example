# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
QDRANT_URL=https://xxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=pdf-rag-collection

# ── Upstash Redis (BullMQ Queue) ──────────────────────────────────────────────
REDIS_HOST=your-db.upstash.io
REDIS_PORT=6380
REDIS_PASSWORD=your_upstash_password_here
REDIS_TLS=true

# ── Cloudinary (PDF Storage) ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── CORS (restrict to your Vercel domain in production) ───────────────────────
ALLOWED_ORIGINS=https://your-app.vercel.app
